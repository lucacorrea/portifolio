Options -Indexes
DirectoryIndex public/index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|config|database|storage|bin|docs|tests)(/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^$ public/ [R=302,L]
</IfModule>
<FilesMatch "(?i)^(?:\.env(?:\..*)?|composer\.(?:json|lock)|.*\.(?:sql|sqlite|log|bak|old|ini|md))$">
Require all denied
</FilesMatch>
