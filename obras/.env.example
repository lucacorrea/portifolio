APP_NAME="OBRAS360 | Coari"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Manaus
# sqlite (demonstração/início rápido) OU mysql (produção). Exige extensão PDO correspondente.
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite
# Se usar mysql, preencha abaixo e crie o banco em utf8mb4:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=obras360
DB_USER=obras360_app
DB_PASSWORD=""
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_UPLOAD_MB=10
# Alterar para o provedor autorizado de tiles no ambiente de produção.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Somente para docker compose MariaDB:
MYSQL_ROOT_PASSWORD=""
