Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteBase /sigesp/

# Expõe somente os assets públicos no endereço limpo /sigesp/assets/.
RewriteRule ^assets(?:/(.*))?$ sigesporte/public/assets/$1 [END]

# Impede acesso HTTP direto ao código privado dentro de sigesporte.
RewriteRule ^sigesporte(?:/|$) - [F,L,NC]

# Envia as rotas limpas ao front controller, preservando a URL original.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "(^\.|\.(env|ini|log|sql|bak|dist|example)$)">
    Require all denied
</FilesMatch>
